# Copy to .env and fill in. docker compose reads it automatically.

# Host address and port to publish on. Keep 127.0.0.1: the app trusts the sign-in header completely, so
# nothing but the reverse proxy (with Authelia in front) may reach it.
ARBLAB_BIND=127.0.0.1
ARBLAB_PORT=8080

# Where "Log out" goes, e.g. https://auth.example.com/logout
LOGOUT_URL=

# The header Caddy's forward_auth fills with the Authelia login (default Remote-User).
USER_HEADER=

# Cookies (only used for one-time notices) are HTTPS-only by default. Set to false when serving plain HTTP.
SECURE_COOKIES=

# Let markets name people who have an Authelia login but haven't joined yet: a helper container copies
# logins and full names out of Authelia's users file (file backend). Set the directory holding users.yml and
# the group that can read it (stat -c %g users.yml).
#COMPOSE_PROFILES=authelia-users
#AUTHELIA_USERS_DIR=/var/lib/authelia-main
#AUTHELIA_GID=993
